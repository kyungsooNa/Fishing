# Caddy가 같은 서버에서 TLS를 끝내고 이 루프백 주소로 전달합니다.
HOST=127.0.0.1
PORT=8080
WATCH_PUBLIC=1

# 코드 배포와 분리해 영구 보존할 상태입니다.
MONITOR_PATH=/var/lib/fishing/monitor.json
ALERTS_PATH=/var/lib/fishing/alerts.jsonl
USAGE_PATH=/var/lib/fishing/usage.jsonl
CLOUD_COLLECT_STATE_PATH=/var/lib/fishing/cloud-collect.json

# 상시 수집기가 바쁠 때 공식 사이트 조사까지 겹치지 않게 기본은 끕니다.
RESEARCH_AUTO_HOURS=0

# 필요할 때 실제 값을 넣습니다. 이 파일의 권한은 600으로 두세요.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK=
